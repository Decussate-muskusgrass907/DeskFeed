generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Device {
  id                  String    @id @default(uuid())
  name                String
  pairingPin          String    @unique
  pairingPinExpiresAt DateTime?
  isPaired            Boolean   @default(false)
  fcmToken            String?
  lastSeen            DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  activityLogs   ActivityLog[]
  emailAlerts    EmailAlert[]
  webrtcSessions WebRTCSession[]
}

model ActivityLog {
  id           String   @id @default(uuid())
  deviceId     String
  timestamp    DateTime @default(now())
  appName      String?
  browserUrl   String?
  folderPath   String?
  windowTitle  String?

  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp])
}

model EmailAlert {
  id         String   @id @default(uuid())
  deviceId   String
  subject    String
  sender     String
  receivedAt DateTime @default(now())

  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, receivedAt])
}

model WebRTCSession {
  id          String   @id @default(uuid())
  deviceId    String
  offer       String?
  answer      String?
  candidates  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  deviceId     String   @unique
  createdAt    DateTime @default(now())
}
